.build/
.swiftpm/
*.xcodeproj
build/
DerivedData/
.DS_Store

# Installers land in package/ so they are easy to find and get synced with the
# rest of the folder, but a 1.2 MB binary per build has no place in history.
package/*.dmg
package/*.pkg

# Secrets. Never commit these — a token in history is a leaked token even if a
# later commit removes it.
.env
.env.*
!.env.example
*.pem
*.p12
